.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Go / frontend build output and dependencies.
bin/
build/
dist/
*.test
coverage.out
node_modules/
.next/

# Local runtime data, workspaces, logs and artifacts.
/data/
/workspaces/
/artifacts/
/logs/
/traces/
*.log

# Editor / OS files.
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

